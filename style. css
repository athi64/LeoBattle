* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #050505;
    color: white;
}

#loadingScreen {
    width: 100vw;
    height: 100vh;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    background:
        radial-gradient(
            circle at center,
            #252525 0%,
            #0d0d0d 45%,
            #000000 100%
        );

    text-align: center;
}

.logo {
    font-size: 80px;
    margin-bottom: 10px;
}

h1 {
    margin: 0;
    font-size: clamp(40px, 8vw, 75px);
    letter-spacing: 8px;
    font-weight: 900;
}

p {
    margin: 12px 0 35px;
    letter-spacing: 4px;
    font-size: 13px;
    opacity: 0.7;
}

.loadingBox {
    width: min(500px, 65vw);
    height: 9px;

    border: 1px solid white;
    border-radius: 20px;
    padding: 2px;
}

#loadingBar {
    width: 0%;
    height: 100%;

    background: white;
    border-radius: 20px;

    transition: width 0.15s linear;
}

#loadingText {
    margin-top: 15px;
    font-size: 12px;
    letter-spacing: 3px;
}

small {
    position: absolute;
    bottom: 18px;
    opacity: 0.45;
    font-size: 11px;
}

/* Portrait screen */

@media (orientation: portrait) {

    #loadingScreen::after {
        content: "↻  ROTATE YOUR PHONE";

        position: absolute;
        bottom: 70px;

        font-size: 12px;
        letter-spacing: 2px;
        opacity: 0.65;
    }
}

/* Landscape screen */

@media (orientation: landscape) {

    .logo {
        font-size: 60px;
    }

    h1 {
        font-size: 55px;
    }
}
